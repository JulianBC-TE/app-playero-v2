{
  "descripcion": "App offline-first que se conecta a bakend para verificacion y descargar datos necesarios",
  "extensiones": [
    ".py",
    ".js",
    ".ts",
    ".jsx",
    ".tsx"
  ],
  "ignorar": [
    "node_modules",
    ".git",
    "__pycache__",
    "dist",
    "venv",
    "build"
  ],
  "incluir_solo": [
    "src",
    "app",
    "api"
  ],
  "limite_lineas": null,
  "omitir_autogenerados": true,
  "carpeta_salida": ".codigo_completo",
  "nombre_salida": "contexto_codigo.txt",
  "nombre_salida_cambios": "cambios_git.txt",
  "nombre_salida_co": "mapa_contexto.txt",
  "modelo": "default",
  "comprimir": null
}